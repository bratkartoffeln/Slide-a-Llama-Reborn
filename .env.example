# Copy to .env on the NAS. These ports are proposals; check availability first.
SLIDE_PORT=2568
SLIDE_LAN_BIND=0.0.0.0
SLIDE_HTTPS_PORT=19943
# Required only for HTTPS: use a hostname owned by you, without scheme/port.
# Sharing the RPS hostname is supported with separate external ports.
# Never put an API token here.
SLIDE_DOMAIN=flusensieb.dns.navy
# Optional comma-separated WebSocket origin allowlist.
# Empty: current host, Android app origin https://localhost, or clients without Origin.
# Include the public origin WITH its external port, and desired LAN origins.
# For the Android APK also include https://localhost when using this allowlist.
SLIDE_ALLOWED_ORIGINS=
