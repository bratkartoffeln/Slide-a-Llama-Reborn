# Copy to .env on the NAS. These ports are proposals; check availability first.
SLIDE_PORT=2568
SLIDE_LAN_BIND=0.0.0.0
SLIDE_HTTPS_PORT=19943
# Required only for HTTPS: use a NEW hostname owned by you, without scheme/port.
# Do not use the RPS hostname. Never put an API token here.
SLIDE_DOMAIN=
# Optional comma-separated WebSocket origin allowlist.
# Empty: requests matching the current host, or native clients without Origin.
# Include the public origin WITH its external port, and desired LAN origins.
SLIDE_ALLOWED_ORIGINS=
