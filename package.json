{
  "name": "slide-a-llama-reborn",
  "version": "0.1.2",
  "private": true,
  "type": "module",
  "description": "Slide-a-Llama: ein taktisches Früchte-Duell mit privaten Online-Spielräumen und Chat.",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "check": "tsc --noEmit && tsc -p tsconfig.server.json --noEmit",
    "test": "node --import tsx --test tests/*.test.ts",
    "build": "npm run check && vite build && tsc -p tsconfig.server.json",
    "start": "node dist/server/server/index.js",
    "test:browser": "playwright test",
    "check:docker": "node scripts/check-docker.mjs"
  },
  "dependencies": {
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.0",
    "@types/node": "^22.18.0",
    "@types/ws": "^8.18.0",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vite": "^7.1.9"
  }
}
